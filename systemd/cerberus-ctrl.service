[Unit]
Description=Cerberus-V Control Plane
After=network-online.target
Wants=network-online.target
PartOf=cerberus.target
Conflicts=cerberus-network-recovery.service

[Service]
Type=simple
User=outspoken
Group=outspoken
WorkingDirectory=/home/outspoken/Cerberus-V
ExecStart=/home/outspoken/Cerberus-V/ctrl/cerberus-ctrl
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3
TimeoutStartSec=30
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cerberus-ctrl

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=512M
CPUQuota=50%

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/cerberus /etc/cerberus /sys/fs/bpf
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=cerberus.target 