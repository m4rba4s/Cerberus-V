[Unit]
Description=Cerberus-V Data Plane (eBPF + VPP)
After=cerberus-ctrl.service network-online.target
Wants=network-online.target
PartOf=cerberus.target
Conflicts=cerberus-network-recovery.service

[Service]
Type=simple
User=outspoken
Group=outspoken
WorkingDirectory=/home/outspoken/Cerberus-V
ExecStartPre=/home/outspoken/Cerberus-V/scripts/preflight-network.sh
ExecStart=/home/outspoken/Cerberus-V/scripts/load_xdp_adaptive.sh
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
StartLimitInterval=60
StartLimitBurst=2
TimeoutStartSec=60
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cerberus-dataplane

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=1G
CPUQuota=80%

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/cerberus /etc/cerberus /sys/fs/bpf /dev/hugepages
PrivateTmp=true
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Capabilities for eBPF
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_ADMIN

[Install]
WantedBy=cerberus.target 