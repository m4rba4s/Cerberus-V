# 🔍 Monitoring & Diagnostics

## **Real-time Network Health**

```bash
#!/usr/bin/env bash
# scripts/network-health.sh
set -euo pipefail

monitor_network_health() {
    while true; do
        # Check connectivity
        if ! ping -c 1 8.8.8.8 >/dev/null 2>&1; then
            echo "🚨 Network connectivity lost - triggering recovery"
            /home/outspoken/Cerberus-V/scripts/panic.sh
            sleep 10
        fi
        
        # Check XDP/TC programs
        if ! bpftool net show | grep -q "xdp\|tc"; then
            echo "⚠️  No firewall programs attached - reloading"
            /home/outspoken/Cerberus-V/scripts/load_firewall_adaptive.sh wlp0s20f0u12
        fi
        
        # Check system resources
        if [[ $(free -m | awk 'NR==2{printf "%.0f", $3*100/$2}') -gt 90 ]]; then
            echo "🚨 High memory usage - cleaning up"
            sudo sync && echo 3 | sudo tee /proc/sys/vm/drop_caches
        fi
        
        sleep 30
    done
}
```

## **Performance Metrics**

```bash
#!/usr/bin/env bash
# scripts/metrics.sh
set -euo pipefail

collect_metrics() {
    echo "# HELP cerberus_packets_total Total packets processed"
    echo "# TYPE cerberus_packets_total counter"
    
    # BPF map statistics
    if [[ -f /sys/fs/bpf/cerberus/stats_map ]]; then
        bpftool map dump pinned /sys/fs/bpf/cerberus/stats_map | \
        jq -r '.[] | select(.value != null) | "cerberus_packets_total{type=\"\(.key)\"} \(.value)"'
    fi
    
    echo "# HELP cerberus_drop_rate Drop rate percentage"
    echo "# TYPE cerberus_drop_rate gauge"
    
    # Calculate drop rate
    local total=$(bpftool map dump pinned /sys/fs/bpf/cerberus/stats_map 2>/dev/null | \
                  jq -r '.[] | select(.key == 0) | .value // 0')
    local drops=$(bpftool map dump pinned /sys/fs/bpf/cerberus/stats_map 2>/dev/null | \
                  jq -r '.[] | select(.key == 1) | .value // 0')
    
    if [[ "$total" -gt 0 ]]; then
        local rate=$(echo "scale=2; $drops * 100 / $total" | bc -l 2>/dev/null || echo "0")
        echo "cerberus_drop_rate $rate"
    else
        echo "cerberus_drop_rate 0"
    fi
}
```

