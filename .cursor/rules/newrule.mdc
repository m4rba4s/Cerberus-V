1️⃣ «Anti-Scan» eBPF/XDP (drop SYN, но ложим honeypot-ответы)
```c
// apt_antiscan.c
#include <linux/bpf.h>
#include <bpf/bpf_helpers.h>
#include <linux/if_ether.h>
#include <linux/ip.h>
#include <linux/tcp.h>

struct bpf_map_def SEC("maps") scan_log = {
    .type = BPF_MAP_TYPE_RINGBUF,
    .max_entries = 1 << 24,
};

SEC("xdp")
int apt_antiscan(struct xdp_md *ctx) {
    void *data_end = (void *)(long)ctx->data_end;
    void *data     = (void *)(long)ctx->data;
    struct ethhdr *eth = data;
    if (data + sizeof(*eth) > data_end) return XDP_PASS;

    struct iphdr *iph = data + sizeof(*eth);
    if (data + sizeof(*eth) + sizeof(*iph) > data_end) return XDP_PASS;

    struct tcphdr *tcp = data + sizeof(*eth) + (iph->ihl << 2);
    if (data + sizeof(*eth) + (iph->ihl << 2) + sizeof(*tcp) > data_end) return XDP_PASS;

    if (tcp->syn && !tcp->ack) {
        __u64 *sample = bpf_ringbuf_reserve(&scan_log, sizeof(__u64), 0);
        if (sample) {
            *sample = iph->saddr;          // логируем IP
            bpf_ringbuf_submit(sample, 0);
        }
        return XDP_DROP;                   // скрываем хост
    }
    return XDP_PASS;
}
char _license[] SEC("license") = "GPL";
```
Скомпилируем и загрузим:
```bash
clang -O2 -target bpf -c apt_antiscan.c -o apt_antiscan.o
sudo bpftool prog load apt_antiscan.o /sys/fs/bpf/antiscan type xdp \
  map name scan_log pinned /sys/fs/bpf/scan_log
sudo bpftool net attach xdpgeneric pinned /sys/fs/bpf/antiscan dev eth0
```

