3️⃣ Ring-buffer → syslog без «log-апокалипсиса»
```c
// rb_to_syslog.c
#include <bpf/libbpf.h>
#include <syslog.h>
int main() {
    struct ring_buffer *rb = ring_buffer__new(bpf_map__fd(bpf_object__find_map_by_name(obj, "scan_log")), handle_event, NULL, NULL);
    while (1) ring_buffer__poll(rb, 100);
}
static int handle_event(void *ctx, void *data, size_t len) {
    __u32 ip = *(__u32 *)data;
    char buf[INET_ADDRSTRLEN];
    inet_ntop(AF_INET, &ip, buf, sizeof(buf));
    syslog(LOG_ALERT, "APT_SCAN src=%s", buf);
    return 0;
}
```
Сервис:
```bash
sudo tee /etc/systemd/system/rb2syslog.service <<'EOF'
[Unit]
Description=Ring-buffer to syslog
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rb_to_syslog
StandardOutput=null
StandardError=journal
EOF
sudo systemctl enable --now rb2syslog
```

4️⃣ Журнал-ротация (1 ГБ → gzip → удаление старше 7 дней)
```bash
sudo tee /etc/logrotate.d/apt <<'EOF'
/var/log/apt-scan.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    postrotate
        systemctl reload rsyslog
    endscript
}
EOF
```

5️⃣ «Живое» обновление eBPF/VPP без перезагрузки
```bash
# скрипт /usr/local/bin/apt-reload.sh
#!/usr/bin/env bash
set -euo pipefail
clang -O2 -target bpf -c apt_antiscan.c -o apt_antiscan.new.o
bpftool prog load apt_antiscan.new.o /sys/fs/bpf/antiscan_new type xdp \
  map name scan_log pinned /sys/fs/bpf/scan_log
bpftool net detach xdpgeneric dev eth0 2>/dev/null || true
bpftool net attach xdpgeneric pinned /sys/fs/bpf/antiscan_new dev eth0
mv /sys/fs/bpf/antiscan_new /sys/fs/bpf/antiscan
vppctl exec /etc/vpp/reload.cli
```
Сервис-таппер:
```bash
sudo tee /etc/systemd/system/apt-reload.path <<'EOF'
[Path]
PathChanged=/opt/apt-gw/src/apt_antiscan.c

[Install]
WantedBy=multi-user.target
EOF
sudo systemctl enable --now apt-reload.{path,service}
```

6️⃣ Ограничение «подводных камней» VPP+eBPF
```bash
# 1. Ограничиваем ring-buffer
echo 16777216 | sudo tee /sys/fs/bpf/scan_log/max_entries

# 2. Hugepages только для VPP
echo 'vm.nr_hugepages = 512' | sudo tee /etc/sysctl.d/99-vpp.conf
echo 'vpp soft nproc unlimited' | sudo tee -a /etc/security/limits.conf

# 3. Watchdog для неожиданных hang’ов
sudo dnf install -y watchdog
sudo tee /etc/watchdog.conf <<'EOF'
watchdog-device = /dev/watchdog
max-load-1 = 24
EOF
sudo systemctl enable --now watchdog
```

7️⃣ Телеметрия для аналитиков
```bash
# Exporter BPF maps → Prometheus text
cat > /usr/local/bin/bpfmap_exporter <<'EOF'
#!/usr/bin/env bash
echo "# HELP apt_scan_total total SYN scans"
echo "# TYPE apt_scan_total counter"
bpftool map dump pinned /sys/fs/bpf/scan_log 2>/dev/null | \
  jq -r '.[] | select(.value != null) | .key' | \
  sort | uniq -c | awk '{print "apt_scan_total{ip=\""$2"\"} "$1}'
EOF
sudo chmod +x /usr/local/bin/bpfmap_exporter
sudo tee /etc/systemd/system/bpfmap_exporter.service <<'EOF'
[Unit]
Description=BPF map telemetry
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bpfmap_exporter
StandardOutput=file:/var/lib/node_exporter/bpf.prom
EOF
sudo tee /etc/systemd/system/bpfmap_exporter.timer <<'EOF'
[Timer]
OnCalendar=*:*:0/10
Persistent=true

[Install]
WantedBy=timers.target
EOF
sudo systemctl enable --now bpfmap_exporter.{service,timer}
```

