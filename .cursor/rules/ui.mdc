# ⚙️ 4. LIVE ↔ SIMULATION Switch UX (Web UI)

```tsx
// gui/frontend/src/components/LiveToggle.tsx
import { Switch } from '@headlessui/react';
import { useState } from 'react';

export default function LiveToggle() {
  const [live, setLive] = useState(false);
  const [confirm, setConfirm] = useState(false);

  const handleChange = async (next: boolean) => {
    if (next) {
      setConfirm(true);
      return;
    }
    await fetch('/api/mode', { method: 'POST', body: JSON.stringify({ mode: 'sim' }) });
    setLive(false);
  };

  return (
    <>
      <Switch checked={live} onChange={handleChange} className="..."/>
      {confirm && (
        <ConfirmModal
          title="Enable LIVE mode?"
          body="Packets will be dropped instantly. Type 'LIVE' to confirm."
          onConfirm={async () => {
            await fetch('/api/mode', { method: 'POST', body: JSON.stringify({ mode: 'live' }) });
            setLive(true);
            setConfirm(false);
          }}
        />
      )}
    </>
  );
}
```

