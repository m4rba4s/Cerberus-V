# fuzz/live_switch_fuzzer.go
func FuzzSwitch(f *testing.F) {
    f.Add([]byte(`{"mode":"live"}`))
    f.Fuzz(func(t *testing.T, data []byte) {
        req := new(api.ModeRequest)
        if json.Unmarshal(data, req) != nil {
            return
        }
        if err := api.SetMode(req.Mode); err != nil {
            t.Skip()
        }
    })
}
