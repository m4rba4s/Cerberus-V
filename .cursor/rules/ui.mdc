# 🧪 5. Pre-Flight Checklist before LIVE

```bash
#!/usr/bin/env bash
# scripts/live_preflight.sh
set -euo pipefail

echo "🔍 Checking shadow map size…"
used=$(bpftool map dump id $(bpftool map show | awk '/shadow/ {print $1}') | wc -l)
[[ $used -lt 900000 ]] || { echo "Map >90 % full"; exit 1; }

echo "🔍 Ping loopback…"
ping -c 1 -W 1 127.0.0.1 >/dev/null || { echo "loop down"; exit 1; }

echo "🔍 VPP alive…"
vppctl show version >/dev/null || { echo "VPP down"; exit 1; }

echo "✅ Preflight OK"
```

