## Panic-kit (скрипт ядра отката)

```bash
# /usr/local/sbin/cerb-panic-revert.sh
set -euo pipefail
logger -p authpriv.alert "CERB: PANIC REVERT INITIATED"
# 1) снять XDP (восстановить линуксовый fastpath)
for i in $(ip -o link show | awk -F': ' '{print $2}'); do
  ip link set dev "$i" xdp off 2>/dev/null || true
done
# 2) остановить VPP и разлинковать memif
systemctl stop vpp 2>/dev/null || true
rm -f /run/cerberus/memif.sock || true
# 3) восстановить LKG firewall профиль
if [ -f /var/lib/cerberus/lkg/iptables.rules ]; then
  iptables-restore < /var/lib/cerberus/lkg/iptables.rules || true
fi
if [ -f /var/lib/cerberus/lkg/nft.rules ]; then
  nft -f /var/lib/cerberus/lkg/nft.rules || true
fi
# 4) маршруты/arp к mgmt
ip route replace default via "$(cat /var/lib/cerberus/lkg/gw 2>/dev/null || echo '')" || true
logger -p authpriv.alert "CERB: PANIC REVERT COMPLETE"
```

unit:

```
[Unit]
Description=Cerberus Panic Revert
DefaultDependencies=no
Before=network-pre.target
Wants=network-pre.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cerb-panic-revert.sh
[Install]
WantedBy=emergency.target
```

